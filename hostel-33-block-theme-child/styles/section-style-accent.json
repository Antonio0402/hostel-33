{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "Accent",
  "slug": "hostel-33-block-theme/section-style-accent",
  "blockTypes": [
    "core/group"
  ],
  "styles": {
    "border": {
      "radius": "5px"
    },
    "color": {
      "background": "var:preset|color|contrary",
      "text": "var:preset|color|white"
    },
    "spacing": {
      "padding": {
        "top": "var:preset|spacing|large",
        "right": "var:preset|spacing|large",
        "bottom": "var:preset|spacing|large",
        "left": "var:preset|spacing|large"
      }
    },
    "blocks": {
      "core/paragraph": {
        "color": {
          "text": "var:preset|color|white"
        }
      }
    },
    "elements": {
      "heading": {
        "color": {
          "text": "var:preset|color|white"
        }
      }
    }
  }
}